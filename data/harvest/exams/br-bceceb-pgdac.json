  "eligibility": {
   "value": {
    "education_levels": [
     "Graduate"
    ],
    "clauses": [
     {
      "text": "(i) The candidates must have passed the BDS Examination from any recognised Dental College of Bihar State included in the schedule of Dental Council of India",
      "page": 4
     },
     {
      "text": "(iii) The candidates must have completed the rotating Internship on or before 31.05.2026 as per the provision contained in the Information bulletin of NEET(MDS)-2026",
      "page": 4
     },
     {
      "text": "(iv) The candidates must have obtained Registration from Bihar State Dental Council or Dental Council of India",
      "page": 4
     },
     {
      "text": "A candidate who is not a permanent resident of Bihar but has passed the BDS Examination from any Dental Colleges of Bihar State included in the Schedule of Dental Council of India, is also eligible",
      "page": 4
     },
     {
      "text": "* For Eligibility Criteria and other details, required Documents for admission on (DQ) Quota, candidates are advised to see 'Chapter 4: Persons with Benchmark Disabilities (PwBD) of Information Bulleting & Counselling Scheme of NEET-MDS Counselling 2026' which can be seen on MCC Official Website",
      "page": 9
     },
     {
      "text": "All the certificates included in the list given below, if applicable, must have to upload at the time of downloading his/ her Provisional Seat Allotment Order and have to submit in original by every candidate at the time of Document Verification & Admission process",
      "page": 11
     },
     {
      "text": "In addition to this, the individual should have a speech discrimination score of more than 60%",
      "page": 23
     }
    ]
   },
