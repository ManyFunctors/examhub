 "eligibility": {
  "education_levels": [
   "Graduate"
  ],
  "clauses": [
   {
    "text": "AGE & EDUCATIONAL QUALIFICATION:",
    "page": 3
   },
   {
    "text": "(For fulfillment of eligibility criteria relating to age, educational qualification, etc.)",
    "page": 3
   },
   {
    "text": "Minimum 20 years and Maximum 28 years as on cut-off date i.e. candidates must have been born not later than 01.11.2006 and not earlier than 02.11.1998 (both days inclusive)",
    "page": 3
   },
   {
    "text": "Educational Qualification",
    "page": 3
   },
   {
    "text": "Graduate degree in any discipline from a recognized University or any equivalent qualifications recognized as such by the Central Government",
    "page": 3
   },
   {
    "text": "Candidates must have passed their Graduation on or after 01.04.2022 and",
    "page": 3
   },
   {
    "text": "The candidate should possess a valid OBC certificate with a non-creamy layer clause as per the Government of India guidelines, from time to time",
    "page": 4
   },
   {
    "text": " Both the candidate as well as scribe will have to give a suitable undertaking confirming that the scribe fulfils all the stipulated eligibility criteria for a scribe mentioned above",
    "page": 6
   },
   {
    "text": "Further in case it later transpires that he/she did not fulfil any laid down eligibility criteria or suppressed material facts the candidature of the applicant will stand cancelled, irrespective of the result",
    "page": 6
   },
   {
    "text": "Registration Process All eligible candidates need to register himself/herself on the apprenticeship portal (NATS 2.0 Portal) - www.nats.education.gov.in before applying for apprenticeship in the Bank. (Only for candidates who have passed their graduation examination on or after 1st April 2022)",
    "page": 8
   },
   {
    "text": " Candidates who have already undergone apprenticeship training or have job experience for a period of 01 year or more after completion of educational qualifications shall not be eligible for being engaged as apprentice",
    "page": 9
   },
   {
    "text": " Mark sheets or certificates for educational qualifications",
    "page": 18
   },
   {
    "text": "Only those candidates who agree to the terms and conditions as stipulated by the Bank and fulfil the eligibility criteria need to apply",
    "page": 22
   },
   {
    "text": "My educational qualification is _______________________",
    "page": 29
   }
  ]
